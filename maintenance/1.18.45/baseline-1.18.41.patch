+    /** Under load preserve the position, class color, impact radius and travelling orb. */
+    private static void simple(WorldRenderContext context, S2C_SkillPattern p, float age, float fade, float r, float g, float b) {
+        MatrixStack m = context.matrixStack();
+        if (p.shape() == 7 || p.shape() == 18) {
+            m.multiply(context.camera().getRotation());
+            VertexConsumer orb = context.consumers().getBuffer(RenderLayer.getEyes(GLOW));
+            sprite(orb, m.peek(), 0, 0, 0.36f, 0.36f, r, g, b);
+            return;
+        }
+        VertexConsumer v = context.consumers().getBuffer(RenderLayer.getEyes(FILAMENT));
+        float radius = (float)Math.min(5.0, Math.max(0.5, p.radius()));
+        radius *= Math.min(1.0f, 0.35f + age * 0.15f);
+        for (int i = 0; i < 12; i++) {
+            double a = i * Math.PI / 6, z = (i + 1) * Math.PI / 6;
+            float x0 = (float)Math.cos(a) * radius, z0 = (float)Math.sin(a) * radius;
+            float x1 = (float)Math.cos(z) * radius, z1 = (float)Math.sin(z) * radius;
+            vertex(v,m.peek(),x0,0.04f,z0,0,0,r,g,b);
+            vertex(v,m.peek(),x1,0.04f,z1,1,0,r,g,b);
+            vertex(v,m.peek(),x1*0.96f,0.04f,z1*0.96f,1,1,r,g,b);
+            vertex(v,m.peek(),x0*0.96f,0.04f,z0*0.96f,0,1,r,g,b);
+        }
+        m.multiply(context.camera().getRotation());
+        if (p.shape() == 6) streak(v,m.peek(),0,0.15f,-0.15f,1.6f,0.07f,r,g,b);
+        else if (p.shape() == 24 || p.shape() == 25) claws(v,m.peek(),age,r,g,b);
+        else sprite(context.consumers().getBuffer(RenderLayer.getEyes(GLOW)),m.peek(),0,0.7f,0.24f,0.35f,r*0.6f,g*0.6f,b*0.6f);
+    }
